{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "jackie-and-ryan",
	// Astro handles HTTP; src/worker.ts adds the queue consumer for AI drafting.
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Per-version preview URLs are not used; keep them off so only the main URL serves the site.
	"preview_urls": false,
	// The site's real address. Deploying creates the DNS records and certificates;
	// www redirects to the bare domain in src/middleware.ts.
	"routes": [
		{ "pattern": "jackieandryan.us", "custom_domain": true },
		{ "pattern": "www.jackieandryan.us", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	},
	// Cloudflare Access (Zero Trust) login for the admin pages; see src/lib/access.ts.
	// ADMIN_EMAILS is a secret (`wrangler secret put ADMIN_EMAILS`) so it stays out of this public repo.
	"vars": {
		"ACCESS_TEAM_DOMAIN": "silent-resonance-d3bf.cloudflareaccess.com",
		// Audience tags of the Access applications in front of the site, comma-separated:
		// jackie-and-ryan.jackie-and-ryan.workers.dev, then jackieandryan.us (with www).
		"ACCESS_AUD": "ae63a700c923ac30570decbc7fd01a41f07caba63ad57fa5828471a6830f373e,da47821b9fa1a642991e12b6cde6f6dd1d9361e99abd5225868b558d5b893eec",
		// Claude model for AI drafting, confirmed with Jackie and Ryan. ANTHROPIC_API_KEY is a secret.
		"DRAFT_MODEL": "claude-sonnet-5-5",
		// Models for background research with web search, one per service; the admin
		// page picks the service per run. GEMINI_API_KEY is a secret.
		"RESEARCH_CLAUDE_MODEL": "claude-sonnet-5-5",
		"RESEARCH_GEMINI_MODEL": "gemini-4-argon",
		// Cloudflare account for Stream (video) API calls; STREAM_API_TOKEN (Stream:Edit) is a secret.
		"CF_ACCOUNT_ID": "20e6f51bcc7e4165c334278636f65709"
	},
	// Background AI drafting: the admin page enqueues a job and the consumer in
	// src/worker.ts runs it. One job per batch; up to 2 retries for rate limits and API errors.
	"queues": {
		"producers": [{ "binding": "DRAFT_QUEUE", "queue": "jackie-and-ryan-drafts" }],
		"consumers": [{ "queue": "jackie-and-ryan-drafts", "max_batch_size": 1, "max_retries": 2 }]
	},
	// Posts, photo metadata and AI drafting jobs.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jackie-and-ryan",
			"database_id": "ff113e0f-5e13-4943-b9d4-76932370c0f2",
			"migrations_dir": "migrations"
		}
	],
	// Photo files (original, display and thumbnail sizes), keyed as photos/<post id>/<photo id>/<size>.jpg
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "jackie-and-ryan-photos"
		}
	]
}
