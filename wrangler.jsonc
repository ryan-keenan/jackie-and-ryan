{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "jackie-and-ryan",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Posts, photo metadata and AI drafting jobs.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "jackie-and-ryan",
			"database_id": "ff113e0f-5e13-4943-b9d4-76932370c0f2",
			"migrations_dir": "migrations"
		}
	],
	// Photo files (original, display and thumbnail sizes), keyed as photos/<post id>/<photo id>/<size>.jpg
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "jackie-and-ryan-photos"
		}
	]
}
