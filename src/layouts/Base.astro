---
interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Our journal' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/wedding/images/sparkles-emoji-transparent.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Poppins:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-title" href="/">Jackie &amp; Ryan</a>
			<nav>
				<a href="/">Journal</a>
				<a href="/wedding/">Wedding</a>
			</nav>
		</header>
		<slot />
		<footer class="site-footer">
			<a href="/">Jackie &amp; Ryan</a>
		</footer>
	</body>
</html>

<style is:global>
	/* Palette and fonts follow the wedding page (public/wedding/styles.css). */
	:root {
		--bg: #fafafa;
		--surface: #ffffff;
		--text: #2c2c2c;
		--muted: #666666;
		--rule: #e6e2dc;
		--accent: #b8935f;
		--accent-soft: #d4a574;
		--serif: 'Fraunces', Georgia, serif;
		--sans: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
		--measure: 42rem;
		color-scheme: light;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--sans);
		font-weight: 300;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		font-family: var(--serif);
		font-weight: 400;
		line-height: 1.2;
	}

	a {
		color: inherit;
	}

	/* Body text is Poppins 300; 500 is the heaviest weight loaded. */
	strong,
	b {
		font-weight: 500;
	}

	img {
		max-width: 100%;
		height: auto;
		display: block;
	}
</style>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		max-width: 72rem;
		margin: 0 auto;
		padding: 1.25rem 16px;
	}

	.site-title {
		font-family: var(--serif);
		font-size: 1.35rem;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9rem;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--text);
	}

	.site-footer {
		margin-top: 5rem;
		padding: 2rem 16px 3rem;
		border-top: 1px solid var(--rule);
		text-align: center;
		font-family: var(--serif);
		color: var(--muted);
	}

	.site-footer a {
		text-decoration: none;
	}
</style>
