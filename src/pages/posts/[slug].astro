---
import Lightbox from '../../components/Lightbox.astro';
import PostBody from '../../components/PostBody.astro';
import TripMap from '../../components/TripMap.astro';
import Base from '../../layouts/Base.astro';
import { parseBody } from '../../lib/blocks';
import { getPhotosForPost, getPublishedPost, getVideosForPost } from '../../lib/db';
import { formatTripDates } from '../../lib/format';
import { mapView } from '../../lib/map';

const post = await getPublishedPost(Astro.params.slug!, 'public');
if (!post) return new Response('Not found', { status: 404 });

const photos = await getPhotosForPost(post.id);
const videos = await getVideosForPost(post.id);
const blocks = parseBody(post.body, photos.map((photo) => photo.id), videos.map((video) => video.id));
const dates = formatTripDates(post.trip_start, post.trip_end);
const map = mapView(post.map_mode, photos);

// Browsers re-check every visit, so edits and unpublishing show up immediately.
Astro.response.headers.set('cache-control', 'no-cache');
---

<Base title={`${post.title} · Jackie & Ryan`} description={post.summary}>
	<main>
		<header class="post-header">
			{(dates || post.location) && <p class="meta">{[post.location, dates].filter(Boolean).join(' · ')}</p>}
			<h1>{post.title}</h1>
			{post.summary && <p class="summary">{post.summary}</p>}
			{Astro.locals.isAdmin && <a class="edit-link" href={`/admin/posts/${post.id}`}>Edit post</a>}
		</header>
		{map && <TripMap view={map} />}
		<PostBody blocks={blocks} photos={photos} videos={videos} />
	</main>
	<Lightbox />
</Base>

<style>
	.post-header {
		max-width: var(--measure);
		margin: 3rem auto 2.5rem;
		padding: 0 16px;
		text-align: center;
	}

	.meta {
		margin: 0;
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h1 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(2.2rem, 6vw, 3.4rem);
	}

	.summary {
		margin: 0;
		font-family: var(--serif);
		font-size: 1.25rem;
		font-style: italic;
		color: var(--muted);
	}

	.edit-link {
		display: inline-block;
		margin-top: 1.25rem;
		padding: 0.3rem 0.9rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		font-size: 0.85rem;
		color: var(--muted);
		text-decoration: none;
	}

	.edit-link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
