---
import Admin from '../../../layouts/Admin.astro';
import { parseBody, type Block } from '../../../lib/blocks';
import { getPhotosForAdmin, getPostForAdmin, getVideosForPost, latestJobForPost, type VideoRow } from '../../../lib/db';
import { formatDuration, formatTakenAt } from '../../../lib/format';
import { thumbnailUrl } from '../../../lib/stream';
import { locatedCount, MAP_MODE_LABELS, MAP_MODES, MAP_STYLE_LABELS, MAP_STYLES, mapSourceHint, mapView } from '../../../lib/map';
import TripMap from '../../../components/TripMap.astro';
import ResearchPanel from '../../../components/ResearchPanel.astro';
import { parseResearch, type Research } from '../../../lib/research';

const post = await getPostForAdmin(Astro.params.id!);
if (!post) return new Response('Not found', { status: 404 });
const photos = await getPhotosForAdmin(post.id);
const videos = await getVideosForPost(post.id);
const job = await latestJobForPost(post.id, 'draft');
const researchJob = await latestJobForPost(post.id, 'research');
// Unreadable research is shown as an error rather than hidden, so drafting can't silently skip it.
let research: Research | null = null;
let researchError: string | null = null;
try {
	research = parseResearch(post.research);
} catch (error) {
	researchError = (error as Error).message;
}
// The preview is built at 'fit' even when the map is off, so switching it on shows it right away.
const mapPreview = mapView('fit', photos, { lat: post.place_lat, lon: post.place_lon });

const videoThumb = (video: VideoRow) =>
	video.status === 'ready' && video.playback_host ? thumbnailUrl(video.playback_host, video.stream_uid, 480) : null;
const videoStatusText: Record<VideoRow['status'], string> = {
	uploading: 'The upload didn\u2019t finish. Delete this and upload it again.',
	processing: 'Processing\u2026 this can take a few minutes.',
	ready: 'Ready',
	error: 'Stream couldn\u2019t process this video.',
};

// A body that fails validation is shown as an error and the editor stays
// disabled, so saving can't silently replace it with an empty post.
let blocks: Block[] = [];
let bodyError: string | null = null;
try {
	blocks = parseBody(post.body, photos.map((photo) => photo.id), videos.map((video) => video.id));
} catch (error) {
	bodyError = (error as Error).message;
}

const editorData = {
	postId: post.id,
	status: post.status,
	blocks,
	summary: post.summary,
	coverPhotoId: post.cover_photo_id,
	editable: bodyError === null,
	job: job && { id: job.id, status: job.status },
	videos: videos.map((video, index) => ({
		id: video.id,
		label: `Video ${index + 1} · ${video.file_name || 'untitled'}`,
		thumbUrl: videoThumb(video),
	})),
	processingVideoIds: videos.filter((video) => video.status === 'processing').map((video) => video.id),
	photos: photos.map((photo, index) => ({
		id: photo.id,
		label: `Photo ${index + 1} · ${formatTakenAt(photo.taken_at)}`,
		thumbUrl: `/api/admin/media/${photo.r2_key_thumb}`,
	})),
};
// Embedded as JSON in a <script> tag; escaping "<" keeps text in a post from closing the script tag early.
const editorJson = JSON.stringify(editorData).replace(/</g, '\\u003c');

function jobText(): string {
	if (!job) return '';
	if (job.status === 'queued' || job.status === 'running') {
		return job.error ? `Writing a draft… ${job.error}` : 'Writing a draft… this usually takes a minute or two.';
	}
	if (job.status === 'failed') return `The last draft failed: ${job.error}`;
	const tokens = job.input_tokens !== null ? ` · ${job.input_tokens.toLocaleString()} in / ${job.output_tokens?.toLocaleString()} out tokens` : '';
	return `Last drafted by ${job.model}${tokens}`;
}
---

<Admin title={post.title}>
	<div class="workspace" data-post-id={post.id} data-taken-ats={JSON.stringify(photos.map((photo) => photo.taken_at))}>
		<header class="post-head">
			<h1 data-title-display>{post.title}</h1>
			<span class:list={['badge', post.status]}>{post.status === 'draft' ? 'Draft' : 'Published'}</span>
			{post.status === 'published' && post.visibility === 'public' && <a href={`/posts/${post.slug}`}>View post</a>}
		</header>

		<form class="details" id="details-form" novalidate>
			<div class="grid">
				<div class="span-2">
					<label for="title">Title</label>
					<input id="title" name="title" type="text" required maxlength="200" value={post.title} />
				</div>
				<div class="span-2">
					<label for="location">Where</label>
					<input id="location" name="location" type="text" maxlength="200" value={post.location} placeholder="e.g. Taipei and Hualien, Taiwan" />
				</div>
				<div>
					<label for="trip_start">From</label>
					<input id="trip_start" name="trip_start" type="date" value={post.trip_start ?? ''} />
				</div>
				<div>
					<label for="trip_end">To</label>
					<input id="trip_end" name="trip_end" type="date" value={post.trip_end ?? ''} />
				</div>
				<div class="span-2">
					<label for="visibility">Who can see it</label>
					<select id="visibility" name="visibility">
						<option value="public" selected={post.visibility === 'public'}>Everyone</option>
						<option value="private" selected={post.visibility === 'private'}>Family and friends only</option>
					</select>
				</div>
				<div class="span-2">
					<label for="map_mode">Map under the title</label>
					<select id="map_mode" name="map_mode" data-map-setting>
						{MAP_MODES.map((mode) => <option value={mode} selected={post.map_mode === mode}>{MAP_MODE_LABELS[mode]}</option>)}
					</select>
					<p class="field-hint" data-map-hint data-located={locatedCount(photos)}>{mapSourceHint(locatedCount(photos), photos.length, post.place_name)}</p>
				</div>
				<div class="span-2">
					<label for="map_style">Map style</label>
					<div class="style-picker">
						<button type="button" class="button secondary" data-style-step="-1" aria-label="Previous map style">‹</button>
						<select id="map_style" name="map_style" data-map-setting>
							{MAP_STYLES.map((style) => <option value={style} selected={post.map_style === style}>{MAP_STYLE_LABELS[style]}</option>)}
						</select>
						<button type="button" class="button secondary" data-style-step="1" aria-label="Next map style">›</button>
					</div>
					<p class="field-hint">The preview below changes as you pick; Save details to keep it.</p>
				</div>
				{
					mapPreview && (
						<div class="span-4 map-preview">
							<TripMap view={mapPreview} style={post.map_style} preview />
						</div>
					)
				}
				<div class="span-4">
					<label for="author_notes">Notes</label>
					<textarea id="author_notes" name="author_notes" maxlength="20000" placeholder="What happened? Rough notes are fine: places, who you were with, funny moments, what you ate. The AI will write the post from these and the photos.">{post.author_notes}</textarea>
				</div>
			</div>
			<div class="actions">
				<button class="button" type="submit">Save details</button>
				<span class="save-status" role="status" aria-live="polite"></span>
			</div>
		</form>

		<section class="photos">
			<h2>Photos <span class="count" data-photo-count>{photos.length}</span></h2>
			<label class="dropzone" for="photo-input">
				<input id="photo-input" type="file" accept="image/*,video/*,.heic,.heif,.mov,.mp4,.m4v" multiple />
				<strong>Drop photos and videos here</strong> or click to choose. Photos: JPEG, PNG, HEIC or WebP. Videos: anything your phone records, up to 30 minutes.
			</label>
			<ul class="upload-progress" aria-live="polite"></ul>

			<ul class="photo-grid">
				{
					photos.map((photo) => (
						<li class="photo-card" data-photo-id={photo.id}>
							<img src={`/api/admin/media/${photo.r2_key_thumb}`} alt="" loading="lazy" />
							<p class="taken">{formatTakenAt(photo.taken_at)}</p>
							<input class="photo-text" data-field="note" type="text" maxlength="500" value={photo.note} placeholder="Note (optional): what's this?" aria-label="Note about this photo" />
							<details class="caption-fields">
								<summary>Caption and alt text</summary>
								<input class="photo-text" data-field="caption" type="text" maxlength="500" value={photo.caption} placeholder="Caption shown under the photo" aria-label="Caption" />
								<input class="photo-text" data-field="alt" type="text" maxlength="500" value={photo.alt} placeholder="Alt text: describe the photo for screen readers" aria-label="Alt text" />
							</details>
							<div class="card-actions">
								<span class="card-status" role="status" />
								<button class="cover" type="button" data-cover={String(photo.id === post.cover_photo_id)}>{photo.id === post.cover_photo_id ? 'Cover photo' : 'Make cover'}</button>
								<button class="delete" type="button">Delete</button>
							</div>
						</li>
					))
				}
			</ul>
			<template id="photo-card-template">
				<li class="photo-card">
					<img alt="" />
					<p class="taken"></p>
					<input class="photo-text" data-field="note" type="text" maxlength="500" placeholder="Note (optional): what's this?" aria-label="Note about this photo" />
					<details class="caption-fields">
						<summary>Caption and alt text</summary>
						<input class="photo-text" data-field="caption" type="text" maxlength="500" placeholder="Caption shown under the photo" aria-label="Caption" />
						<input class="photo-text" data-field="alt" type="text" maxlength="500" placeholder="Alt text: describe the photo for screen readers" aria-label="Alt text" />
					</details>
					<div class="card-actions">
						<span class="card-status" role="status"></span>
						<button class="cover" type="button" data-cover="false">Make cover</button>
						<button class="delete" type="button">Delete</button>
					</div>
				</li>
			</template>

			<h3 class="videos-head" hidden={videos.length === 0}>Videos <span class="count" data-video-count>{videos.length}</span></h3>
			<ul class="video-list">
				{
					videos.map((video) => (
						<li class="video-card" data-video-id={video.id} data-status={video.status}>
							{videoThumb(video) ? <img class="video-thumb" src={videoThumb(video)} alt="" /> : <div class="video-thumb placeholder">Video</div>}
							<div class="video-body">
								<p class="video-name">{video.file_name || 'Untitled video'} <span class="video-duration">{formatDuration(video.duration)}</span></p>
								<p class:list={['video-state', (video.status === 'error' || video.status === 'uploading') && 'status-error']}>{video.status === 'error' && video.error ? `${videoStatusText.error} ${video.error}` : videoStatusText[video.status]}</p>
								<input class="video-text" data-field="note" type="text" maxlength="500" value={video.note} placeholder="Note (optional): what's happening?" aria-label="Note about this video" />
								<input class="video-text" data-field="caption" type="text" maxlength="500" value={video.caption} placeholder="Caption shown under the video" aria-label="Caption" />
								<div class="card-actions">
									<span class="card-status" role="status" />
									<button class="delete" type="button">Delete</button>
								</div>
							</div>
						</li>
					))
				}
			</ul>
			<template id="video-card-template">
				<li class="video-card" data-status="uploading">
					<div class="video-thumb placeholder">Video</div>
					<div class="video-body">
						<p class="video-name"><span class="name"></span> <span class="video-duration"></span></p>
						<p class="video-state">Starting upload…</p>
						<input class="video-text" data-field="note" type="text" maxlength="500" placeholder="Note (optional): what's happening?" aria-label="Note about this video" />
						<input class="video-text" data-field="caption" type="text" maxlength="500" placeholder="Caption shown under the video" aria-label="Caption" />
						<div class="card-actions">
							<span class="card-status" role="status"></span>
							<button class="delete" type="button">Delete</button>
						</div>
					</div>
				</li>
			</template>
		</section>

		<ResearchPanel postId={post.id} research={research} researchError={researchError} job={researchJob} />

		<section class="post-section">
			<h2>The post</h2>
			<p class="hint">
				When the details and photos are ready, generate a draft. You can edit it below, preview it, and publish when you're
				happy. Generating again replaces the current text.
			</p>
			<div class="draft-bar">
				<button class="button" type="button" id="generate">{blocks.length ? 'Regenerate draft' : 'Generate draft'}</button>
				<span class:list={['draft-status', job?.status === 'failed' && 'status-error']} role="status" aria-live="polite">{jobText()}</span>
			</div>
			{bodyError && <p class="status-error">The saved post can't be shown in the editor: {bodyError}</p>}

			<div class="editor" hidden={blocks.length === 0}>
				<div class="editor-head">
					<label for="summary">Summary (shown under the title and on the homepage)</label>
					<textarea id="summary" rows="2" maxlength="500">{post.summary}</textarea>
				</div>
				<div id="block-editor"></div>
			</div>

			<div class="publish-bar">
				<button class="button secondary" type="button" id="save-post" disabled>Save post</button>
				<a class="button secondary" href={`/admin/posts/${post.id}/preview`} target="_blank" id="preview-link" hidden={blocks.length === 0}>Preview</a>
				<button class="button" type="button" id="publish" data-published={String(post.status === 'published')} hidden={blocks.length === 0}>{post.status === 'published' ? 'Unpublish' : 'Publish'}</button>
				<span class="post-status" role="status" aria-live="polite"></span>
			</div>
			{
				post.visibility === 'private' && (
					<p class="hint">This post is set to family and friends only. Private posts can't be viewed on the site until family logins are added.</p>
				)
			}
			<script type="application/json" id="editor-data" set:html={editorJson} />
		</section>
	</div>
</Admin>

<script>
	import { formatTakenAt } from '../../../lib/format';
	import { tripDateRange } from '../../../lib/photo-meta';
	import type { Block } from '../../../lib/blocks';
	import { preparePhoto, runWithLimit, uploadPhoto, type UploadedPhoto } from '../../../scripts/admin-upload';
	import { BlockEditor, type EditorPhoto, type EditorVideo } from '../../../scripts/block-editor';
	import { uploadVideo, type VideoState } from '../../../scripts/video-upload';
	import { formatDuration } from '../../../lib/format';
	import { mapSourceHint } from '../../../lib/map';
	import { thumbnailUrl } from '../../../lib/stream';

	const workspace = document.querySelector<HTMLElement>('.workspace')!;
	const postId = workspace.dataset.postId!;
	const form = document.querySelector<HTMLFormElement>('#details-form')!;
	const saveStatus = form.querySelector<HTMLElement>('.save-status')!;
	const grid = document.querySelector<HTMLUListElement>('.photo-grid')!;
	const progressList = document.querySelector<HTMLUListElement>('.upload-progress')!;
	const template = document.querySelector<HTMLTemplateElement>('#photo-card-template')!;
	const photoCount = document.querySelector<HTMLElement>('[data-photo-count]')!;

	function setStatus(element: HTMLElement, text: string, ok: boolean) {
		element.textContent = text;
		element.className = `${element.className.replace(/\s*status-(ok|error)/g, '')} ${ok ? 'status-ok' : 'status-error'}`;
	}

	async function sendJson(url: string, method: string, body?: unknown): Promise<unknown> {
		const response = await fetch(url, {
			method,
			headers: body === undefined ? undefined : { 'content-type': 'application/json' },
			body: body === undefined ? undefined : JSON.stringify(body),
		});
		if (!response.ok) {
			const data = (await response.json().catch(() => ({}))) as { error?: string };
			throw new Error(data.error ?? `Request failed (HTTP ${response.status})`);
		}
		return response.json().catch(() => undefined);
	}

	// ---- Post details ----

	function detailsFromForm() {
		const value = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
		return {
			title: value('title').trim(),
			location: value('location').trim(),
			trip_start: value('trip_start') || null,
			trip_end: value('trip_end') || null,
			visibility: value('visibility'),
			map_mode: value('map_mode'),
			map_style: value('map_style'),
			author_notes: value('author_notes'),
		};
	}

	form.addEventListener('submit', async (event) => {
		event.preventDefault();
		const details = detailsFromForm();
		setStatus(saveStatus, 'Saving…', true);
		try {
			const result = (await sendJson(`/api/admin/posts/${postId}`, 'PATCH', details)) as { place?: { name: string } | null };
			document.querySelector('[data-title-display]')!.textContent = details.title;
			// A changed Location was looked up again; show what it matched.
			if (result.place !== undefined) {
				const hint = document.querySelector<HTMLElement>('[data-map-hint]')!;
				hint.textContent = mapSourceHint(Number(hint.dataset.located), grid.children.length, result.place?.name ?? '');
			}
			setStatus(saveStatus, 'Saved', true);
		} catch (error) {
			setStatus(saveStatus, (error as Error).message, false);
		}
	});

	// ---- Map preview ----

	const mapFigure = document.querySelector<HTMLElement>('.map-preview .trip-map');
	// Typed structurally: in this project HTMLSelectElement clashes with the
	// Cloudflare runtime's own Element type (worker-configuration.d.ts).
	type Select = HTMLElement & { value: string; selectedIndex: number; options: { length: number } };
	const modeSelect = document.getElementById('map_mode') as Select;
	const styleSelect = document.getElementById('map_style') as Select;
	function updateMapPreview() {
		mapFigure?.dispatchEvent(new CustomEvent('trip-map:update', { detail: { mode: modeSelect.value, style: styleSelect.value } }));
	}
	modeSelect.addEventListener('change', updateMapPreview);
	styleSelect.addEventListener('change', updateMapPreview);
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-style-step]')) {
		button.addEventListener('click', () => {
			const count = styleSelect.options.length;
			styleSelect.selectedIndex = (styleSelect.selectedIndex + Number(button.dataset.styleStep) + count) % count;
			updateMapPreview();
		});
	}
	updateMapPreview();

	// ---- Photo cards ----

	// Dates of every photo on the post, for filling in the trip dates.
	const takenAts: (string | null)[] = JSON.parse(workspace.dataset.takenAts!);

	function addCard(photo: UploadedPhoto) {
		const card = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
		card.dataset.photoId = photo.id;
		card.querySelector('img')!.src = `/api/admin/media/${photo.r2_key_thumb}`;
		card.querySelector('.taken')!.textContent = formatTakenAt(photo.taken_at);
		card.querySelector<HTMLInputElement>('[data-field="note"]')!.value = photo.note;
		grid.appendChild(card);
		photoCount.textContent = String(grid.children.length);
		editor?.addPhoto({
			id: photo.id,
			label: `Photo ${grid.children.length} · ${formatTakenAt(photo.taken_at)}`,
			thumbUrl: `/api/admin/media/${photo.r2_key_thumb}`,
		});
	}

	grid.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		if (!input.classList.contains('photo-text')) return;
		const card = input.closest<HTMLElement>('.photo-card')!;
		const status = card.querySelector<HTMLElement>('.card-status')!;
		const field = input.dataset.field!;
		try {
			await sendJson(`/api/admin/photos/${card.dataset.photoId}`, 'PATCH', { [field]: input.value });
			setStatus(status, `${field === 'alt' ? 'Alt text' : field[0].toUpperCase() + field.slice(1)} saved`, true);
		} catch (error) {
			setStatus(status, (error as Error).message, false);
		}
	});

	// Delete takes two clicks (no browser confirm dialog): the first arms the button.
	grid.addEventListener('click', async (event) => {
		const button = event.target as HTMLButtonElement;
		if (!button.classList.contains('delete')) return;
		const card = button.closest<HTMLElement>('.photo-card')!;
		const status = card.querySelector<HTMLElement>('.card-status')!;
		if (button.dataset.armed !== 'true') {
			button.dataset.armed = 'true';
			button.textContent = 'Really delete?';
			setTimeout(() => {
				button.dataset.armed = 'false';
				button.textContent = 'Delete';
			}, 4000);
			return;
		}
		button.disabled = true;
		try {
			await sendJson(`/api/admin/photos/${card.dataset.photoId}`, 'DELETE');
			card.remove();
			photoCount.textContent = String(grid.children.length);
		} catch (error) {
			button.disabled = false;
			setStatus(status, (error as Error).message, false);
		}
	});

	// ---- Uploading ----

	async function fillTripDatesIfEmpty() {
		const start = form.elements.namedItem('trip_start') as HTMLInputElement;
		const end = form.elements.namedItem('trip_end') as HTMLInputElement;
		const range = tripDateRange(takenAts);
		if (!range || start.value || end.value) return;
		start.value = range.start;
		end.value = range.end;
		await sendJson(`/api/admin/posts/${postId}`, 'PATCH', { trip_start: range.start, trip_end: range.end });
		setStatus(saveStatus, 'Trip dates filled in from the photos', true);
	}

	async function uploadFiles(files: File[]) {
		const rows = new Map<File, HTMLLIElement>();
		for (const file of files) {
			const row = document.createElement('li');
			row.innerHTML = '<span class="name"></span> <span class="state">Waiting</span>';
			row.querySelector('.name')!.textContent = file.name;
			progressList.appendChild(row);
			rows.set(file, row);
		}
		const update = (file: File, text: string, ok = true) => setStatus(rows.get(file)!.querySelector('.state')!, text, ok);

		let uploadedCount = 0;
		// Three at a time keeps the browser responsive while resizing large photos.
		await runWithLimit(files, 3, async (file) => {
			try {
				update(file, 'Preparing…');
				const prepared = await preparePhoto(file);
				const uploaded = await uploadPhoto(postId, prepared, (fraction) =>
					update(file, `Uploading ${Math.round(fraction * 100)}%`),
				);
				takenAts.push(uploaded.taken_at);
				addCard(uploaded);
				rows.get(file)!.remove();
				uploadedCount++;
			} catch (error) {
				update(file, `Failed: ${(error as Error).message}`, false);
			}
		});

		if (uploadedCount > 0) await fillTripDatesIfEmpty().catch((error) => setStatus(saveStatus, error.message, false));
	}

	const input = document.querySelector<HTMLInputElement>('#photo-input')!;
	const dropzone = document.querySelector<HTMLElement>('.dropzone')!;

	input.addEventListener('change', () => {
		if (input.files?.length) uploadMedia([...input.files]);
		input.value = '';
	});
	dropzone.addEventListener('dragover', (event) => {
		event.preventDefault();
		dropzone.classList.add('dragging');
	});
	dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragging'));
	dropzone.addEventListener('drop', (event) => {
		event.preventDefault();
		dropzone.classList.remove('dragging');
		const files = [...(event.dataTransfer?.files ?? [])];
		if (files.length) uploadMedia(files);
	});
	// ---- The post: drafting, editing and publishing ----

	interface EditorData {
		postId: string;
		status: 'draft' | 'published';
		blocks: Block[];
		summary: string;
		coverPhotoId: string | null;
		editable: boolean;
		job: { id: string; status: string } | null;
		photos: EditorPhoto[];
		videos: EditorVideo[];
		processingVideoIds: string[];
	}

	const data = JSON.parse(document.getElementById('editor-data')!.textContent!) as EditorData;
	const generateButton = document.querySelector<HTMLButtonElement>('#generate')!;
	const draftStatus = document.querySelector<HTMLElement>('.draft-status')!;
	const saveButton = document.querySelector<HTMLButtonElement>('#save-post')!;
	const publishButton = document.querySelector<HTMLButtonElement>('#publish')!;
	const postStatus = document.querySelector<HTMLElement>('.post-status')!;
	const summaryInput = document.querySelector<HTMLTextAreaElement>('#summary')!;

	let dirty = false;
	let coverPhotoId = data.coverPhotoId;

	function markDirty() {
		dirty = true;
		saveButton.disabled = false;
		postStatus.textContent = 'Unsaved changes';
		postStatus.className = 'post-status';
	}

	const editor: BlockEditor | null = data.editable
		? new BlockEditor(document.querySelector<HTMLElement>('#block-editor')!, data.blocks, data.photos, data.videos, markDirty)
		: null;
	summaryInput.addEventListener('input', markDirty);
	window.addEventListener('beforeunload', (event) => {
		if (dirty) event.preventDefault();
	});

	// The cover is saved with the post (Save post), like the rest of the editor.
	grid.addEventListener('click', (event) => {
		const button = event.target as HTMLButtonElement;
		if (!button.classList.contains('cover')) return;
		coverPhotoId = button.closest<HTMLElement>('.photo-card')!.dataset.photoId!;
		for (const other of grid.querySelectorAll<HTMLButtonElement>('.cover')) {
			const isCover = other === button;
			other.dataset.cover = String(isCover);
			other.textContent = isCover ? 'Cover photo' : 'Make cover';
		}
		markDirty();
	});

	async function savePost(): Promise<boolean> {
		if (!editor) return false;
		saveButton.disabled = true;
		setStatus(postStatus, 'Saving…', true);
		try {
			await sendJson(`/api/admin/posts/${postId}/content`, 'PUT', {
				body: editor.getBlocks(),
				summary: summaryInput.value,
				cover_photo_id: coverPhotoId,
			});
			dirty = false;
			setStatus(postStatus, 'Saved', true);
			return true;
		} catch (error) {
			saveButton.disabled = false;
			setStatus(postStatus, (error as Error).message, false);
			return false;
		}
	}
	saveButton.addEventListener('click', savePost);

	publishButton.addEventListener('click', async () => {
		const publish = publishButton.dataset.published !== 'true';
		if (dirty && !(await savePost())) return;
		try {
			await sendJson(`/api/admin/posts/${postId}/publish`, 'POST', { published: publish });
			location.reload();
		} catch (error) {
			setStatus(postStatus, (error as Error).message, false);
		}
	});

	const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

	async function waitForDraft(jobId: string) {
		generateButton.disabled = true;
		setStatus(draftStatus, 'Writing a draft… this usually takes a minute or two.', true);
		for (;;) {
			await sleep(4000);
			const response = await fetch(`/api/admin/jobs/${jobId}`);
			if (!response.ok) {
				setStatus(draftStatus, `Couldn't check the draft (HTTP ${response.status}). Reload to try again.`, false);
				return;
			}
			const job = (await response.json()) as { status: string; error: string | null };
			if (job.status === 'succeeded') {
				dirty = false;
				location.reload();
				return;
			}
			if (job.status === 'failed') {
				setStatus(draftStatus, `The draft failed: ${job.error}`, false);
				generateButton.disabled = false;
				return;
			}
			if (job.error) setStatus(draftStatus, `Writing a draft… ${job.error}`, true);
		}
	}

	// Regenerating replaces the post text, so it takes two clicks when there is text to lose.
	generateButton.addEventListener('click', async () => {
		const hasText = (editor?.getBlocks().length ?? 0) > 0;
		if (hasText && generateButton.dataset.armed !== 'true') {
			generateButton.dataset.armed = 'true';
			generateButton.textContent = 'Replace the current post?';
			setTimeout(() => {
				generateButton.dataset.armed = 'false';
				generateButton.textContent = 'Regenerate draft';
			}, 4000);
			return;
		}
		generateButton.dataset.armed = 'false';
		generateButton.textContent = hasText ? 'Regenerate draft' : 'Generate draft';
		generateButton.disabled = true;
		try {
			const response = await fetch(`/api/admin/posts/${postId}/draft`, { method: 'POST' });
			const body = (await response.json().catch(() => ({}))) as { id?: string; error?: string };
			if (!response.ok || !body.id) throw new Error(body.error ?? `Could not start the draft (HTTP ${response.status})`);
			await waitForDraft(body.id);
		} catch (error) {
			generateButton.disabled = false;
			setStatus(draftStatus, (error as Error).message, false);
		}
	});

	if (data.job && (data.job.status === 'queued' || data.job.status === 'running')) waitForDraft(data.job.id);


	// ---- Videos ----

	const videoList = document.querySelector<HTMLUListElement>('.video-list')!;
	const videoTemplate = document.querySelector<HTMLTemplateElement>('#video-card-template')!;
	const videosHead = document.querySelector<HTMLElement>('.videos-head')!;
	const videoCount = document.querySelector<HTMLElement>('[data-video-count]')!;

	function isVideoFile(file: File): boolean {
		return file.type.startsWith('video/') || /\.(mov|mp4|m4v|webm)$/i.test(file.name);
	}

	/** Splits a drop or file choice into photos (resized in the browser) and videos (sent to Stream). */
	function uploadMedia(files: File[]) {
		const videos = files.filter(isVideoFile);
		const photos = files.filter((file) => !isVideoFile(file));
		if (photos.length) uploadFiles(photos);
		for (const file of videos) startVideoUpload(file);
	}

	function updateVideoCount() {
		videoCount.textContent = String(videoList.children.length);
		videosHead.hidden = videoList.children.length === 0;
	}

	function showVideoState(card: HTMLElement, video: VideoState) {
		card.dataset.status = video.status;
		const state = card.querySelector<HTMLElement>('.video-state')!;
		const messages: Record<VideoState['status'], string> = {
			uploading: 'Uploading…',
			processing: 'Processing… this can take a few minutes.',
			ready: 'Ready',
			error: `Stream couldn't process this video. ${video.error ?? ''}`,
		};
		setStatus(state, messages[video.status], video.status !== 'error');
		card.querySelector('.video-duration')!.textContent = formatDuration(video.duration);
		if (video.status === 'ready' && video.playback_host) {
			const thumb = thumbnailUrl(video.playback_host, video.stream_uid, 480);
			const img = document.createElement('img');
			img.className = 'video-thumb';
			img.src = thumb;
			img.alt = '';
			card.querySelector('.video-thumb')!.replaceWith(img);
			const index = [...videoList.children].indexOf(card);
			editor?.setVideo({ id: video.id, label: `Video ${index + 1} · ${video.file_name || 'untitled'}`, thumbUrl: thumb });
		}
	}

	/** Checks a processing video every 10 seconds until Stream finishes with it. */
	async function watchVideo(card: HTMLElement, videoId: string) {
		for (;;) {
			await sleep(10_000);
			const response = await fetch(`/api/admin/videos/${videoId}`);
			if (!response.ok) {
				setStatus(card.querySelector('.video-state')!, `Couldn't check processing (HTTP ${response.status}). Reload to retry.`, false);
				return;
			}
			const video = (await response.json()) as VideoState;
			showVideoState(card, video);
			if (video.status === 'ready' || video.status === 'error') return;
		}
	}

	function startVideoUpload(file: File) {
		const card = videoTemplate.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
		card.querySelector('.name')!.textContent = file.name;
		videoList.appendChild(card);
		updateVideoCount();
		const state = card.querySelector<HTMLElement>('.video-state')!;

		uploadVideo(postId, file, {
			onCreated: (videoId) => {
				card.dataset.videoId = videoId;
				const index = [...videoList.children].indexOf(card);
				editor?.setVideo({ id: videoId, label: `Video ${index + 1} · ${file.name}`, thumbUrl: null });
			},
			onProgress: (fraction) => setStatus(state, `Uploading ${Math.round(fraction * 100)}%`, true),
		})
			.then((video) => {
				showVideoState(card, video);
				return watchVideo(card, video.id);
			})
			.catch((error: Error) => setStatus(state, `Upload failed: ${error.message}`, false));
	}

	videoList.addEventListener('change', async (event) => {
		const input = event.target as HTMLInputElement;
		if (!input.classList.contains('video-text')) return;
		const card = input.closest<HTMLElement>('.video-card')!;
		const status = card.querySelector<HTMLElement>('.card-status')!;
		if (!card.dataset.videoId) return setStatus(status, 'Wait for the upload to start', false);
		try {
			await sendJson(`/api/admin/videos/${card.dataset.videoId}`, 'PATCH', { [input.dataset.field!]: input.value });
			setStatus(status, input.dataset.field === 'note' ? 'Note saved' : 'Caption saved', true);
		} catch (error) {
			setStatus(status, (error as Error).message, false);
		}
	});

	// Two clicks to delete, as with photos.
	videoList.addEventListener('click', async (event) => {
		const button = event.target as HTMLButtonElement;
		if (!button.classList.contains('delete')) return;
		const card = button.closest<HTMLElement>('.video-card')!;
		const status = card.querySelector<HTMLElement>('.card-status')!;
		if (!card.dataset.videoId) return setStatus(status, 'Wait for the upload to start', false);
		if (button.dataset.armed !== 'true') {
			button.dataset.armed = 'true';
			button.textContent = 'Really delete?';
			setTimeout(() => {
				button.dataset.armed = 'false';
				button.textContent = 'Delete';
			}, 4000);
			return;
		}
		button.disabled = true;
		try {
			await sendJson(`/api/admin/videos/${card.dataset.videoId}`, 'DELETE');
			card.remove();
			updateVideoCount();
		} catch (error) {
			button.disabled = false;
			setStatus(status, (error as Error).message, false);
		}
	});

	for (const videoId of data.processingVideoIds) {
		const card = videoList.querySelector<HTMLElement>(`[data-video-id="${videoId}"]`);
		if (card) watchVideo(card, videoId);
	}
</script>

