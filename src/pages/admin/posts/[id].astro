		margin-left: 0.35rem;
		padding: 0 0.4rem;
		border-radius: 999px;
		background: #f6e6dc;
		color: #8a4b2a;
		font-size: 0.7rem;
	}

	.style-picker select {
		flex: 1;
		min-width: 0;
	}

	.style-picker button {
		padding-inline: 0.8rem;
		font-size: 1.1rem;
		line-height: 1;
	}

	.map-preview :global(.trip-map) {
		width: 100%;
		margin: 0;
	}

	.field-hint {
		margin: 0.35rem 0 0;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.span-4 {
		grid-column: span 4;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-top: 1rem;
	}

	.save-status {
		font-size: 0.9rem;
	}

	.dropzone {
		display: block;
		padding: 2.5rem 1rem;
		border: 2px dashed var(--rule);
		border-radius: 10px;
		background: var(--surface);
