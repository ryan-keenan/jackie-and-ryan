		color: var(--muted) !important;
		font-size: 1rem !important;
		cursor: pointer;
		transition: border-color 0.2s, background 0.2s;
	}

	.dropzone strong {
		color: var(--text);
		font-weight: 500;
	}

	.dropzone:hover,
	.dropzone.dragging {
		border-color: var(--accent-soft);
		background: #fdf9f3;
	}

	.dropzone input {
		position: absolute;
		width: 1px;
		height: 1px;
		opacity: 0;
	}

	.upload-progress {
		list-style: none;
		margin: 1rem 0;
		padding: 0;
		font-size: 0.9rem;
	}

	.upload-progress :global(li) {
		padding: 0.25rem 0;
	}

	.upload-progress :global(.name) {
		color: var(--muted);
	}

	.photo-grid {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
		gap: 1.25rem;
	}

	.photo-card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 6px;
		background: #f0ede8;
	}

	.taken {
		margin: 0.4rem 0;
		font-size: 0.8rem;
		color: var(--muted);
	}

	.photo-note {
		font-size: 0.9rem !important;
		padding: 0.45rem 0.6rem !important;
	}

	.card-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.4rem;
		min-height: 1.6rem;
	}

	.card-status {
		font-size: 0.8rem;
	}

	.delete {
		border: none;
