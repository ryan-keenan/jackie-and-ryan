---
import Admin from '../../layouts/Admin.astro';
import { listAllPosts } from '../../lib/db';

const posts = await listAllPosts();
const updated = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<Admin title="Posts">
	<section class="new-post">
		<h1>Start a new post</h1>
		<form method="post" action="/api/admin/posts">
			<label for="title">Working title</label>
			<div class="row">
				<input id="title" name="title" type="text" required maxlength="200" placeholder="e.g. Taiwan, January 2026" />
				<button class="button" type="submit">Create</button>
			</div>
			<p class="hint">Next you'll add photos and notes. The title can change later.</p>
		</form>
	</section>

	<section>
		<h2>All posts</h2>
		{
			posts.length === 0 ? (
				<p class="hint">No posts yet.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/admin/posts/${post.id}`}>{post.title}</a>
							<span class:list={['badge', post.status]}>{post.status === 'draft' ? 'Draft' : 'Published'}</span>
							{post.visibility === 'private' && <span class="badge private">Private</span>}
							<span class="meta">
								{post.photo_count} {post.photo_count === 1 ? 'photo' : 'photos'} · updated {updated.format(new Date(post.updated_at))}
							</span>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Admin>

<style>
	h1,
	h2 {
		font-size: 1.5rem;
		margin: 0 0 1rem;
	}

	.new-post {
		margin-bottom: 3rem;
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: 10px;
	}

	.row {
		display: flex;
		gap: 0.75rem;
	}

	.hint {
		margin: 0.5rem 0 0;
		font-size: 0.85rem;
		color: var(--muted);
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.posts li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 0.75rem;
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.posts a {
		font-family: var(--serif);
		font-size: 1.15rem;
	}

	.badge {
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		font-size: 0.75rem;
		background: #eee;
	}

	.badge.published {
		background: #e3f1e8;
		color: #2f7d4f;
	}

	.badge.private {
		background: #f3ece2;
		color: #8b6a3e;
	}

	.meta {
		margin-left: auto;
		font-size: 0.85rem;
		color: var(--muted);
	}

	@media (max-width: 600px) {
		.row {
			flex-direction: column;
		}

		.meta {
			margin-left: 0;
			width: 100%;
		}
	}
</style>
