---
import Base from '../layouts/Base.astro';
import { listPublishedPosts } from '../lib/db';
import { journalCards } from '../lib/journal';

const cards = journalCards(await listPublishedPosts('public'));

// Browsers re-check every visit, so edits and unpublishing show up immediately.
Astro.response.headers.set('cache-control', 'no-cache');
---

<Base title="Jackie & Ryan" description="Our journal: trips, adventures and everyday life.">
	<main>
		<section class="intro">
			<h1>Jackie &amp; Ryan</h1>
			<p>Trips, adventures and everyday life.</p>
		</section>

		<ul class="posts">
			{
				cards.map((card) => (
					<li>
						<a href={card.href}>
							{card.image && (
								<img
									src={card.image.src}
									alt={card.image.alt}
									style={card.image.position ? `object-position: ${card.image.position}` : undefined}
									loading="lazy"
									decoding="async"
								/>
							)}
							<div class="card-text">
								{card.meta && <p class="meta">{card.meta}</p>}
								<h2>{card.title}</h2>
								{card.summary && <p class="summary">{card.summary}</p>}
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</main>
</Base>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 16px;
	}

	.intro {
		text-align: center;
		margin: 3rem 0 3.5rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 8vw, 4.5rem);
	}

	.intro p {
		margin: 0.5rem 0 0;
		color: var(--muted);
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: 2.5rem 1.75rem;
	}

	.posts a {
		display: block;
		text-decoration: none;
	}

	.posts img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 4px;
		transition: opacity 0.2s;
	}

	.posts a:hover img {
		opacity: 0.9;
	}

	.card-text {
		padding-top: 0.9rem;
	}

	.meta {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h2 {
		margin: 0.3rem 0 0.4rem;
		font-size: 1.5rem;
	}

	.summary {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
