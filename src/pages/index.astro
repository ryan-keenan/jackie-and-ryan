---
import Base from '../layouts/Base.astro';
import { listPublishedPosts } from '../lib/db';
import { formatTripDates, mediaUrl } from '../lib/format';

const posts = await listPublishedPosts('public');

Astro.response.headers.set('cache-control', 'public, max-age=300');
---

<Base title="Jackie & Ryan" description="Our journal: trips, adventures and everyday life.">
	<main>
		<section class="intro">
			<h1>Jackie &amp; Ryan</h1>
			<p>Trips, adventures and everyday life.</p>
		</section>

		{
			posts.length === 0 ? (
				<p class="empty">
					No posts yet. In the meantime, here's <a href="/wedding/">our wedding</a>.
				</p>
			) : (
				<ul class="posts">
					{posts.map((post) => {
						const meta = [post.location, formatTripDates(post.trip_start, post.trip_end)].filter(Boolean).join(' · ');
						return (
							<li>
								<a href={`/posts/${post.slug}`}>
									{post.cover_thumb_key && (
										<img src={mediaUrl(post.cover_thumb_key)} alt={post.cover_alt ?? ''} loading="lazy" decoding="async" />
									)}
									<div class="card-text">
										{meta && <p class="meta">{meta}</p>}
										<h2>{post.title}</h2>
										{post.summary && <p class="summary">{post.summary}</p>}
									</div>
								</a>
							</li>
						);
					})}
				</ul>
			)
		}
	</main>
</Base>

<style>
	main {
		max-width: 72rem;
		margin: 0 auto;
		padding: 0 16px;
	}

	.intro {
		text-align: center;
		margin: 3rem 0 3.5rem;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.5rem, 8vw, 4.5rem);
	}

	.intro p {
		margin: 0.5rem 0 0;
		color: var(--muted);
	}

	.empty {
		text-align: center;
		color: var(--muted);
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: 2.5rem 1.75rem;
	}

	.posts a {
		display: block;
		text-decoration: none;
	}

	.posts img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: 4px;
		background: #f0ede8;
		transition: opacity 0.2s;
	}

	.posts a:hover img {
		opacity: 0.9;
	}

	.card-text {
		padding-top: 0.9rem;
	}

	.meta {
		margin: 0;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}

	h2 {
		margin: 0.3rem 0 0.4rem;
		font-size: 1.5rem;
	}

	.summary {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
