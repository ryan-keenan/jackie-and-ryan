---
import type { PostSource } from '../lib/research';

// The web sources behind the background facts in a post, listed after its text.
// They come from the research the draft used (src/lib/ai/schema.ts).

interface Props {
	sources: PostSource[];
}

const { sources } = Astro.props;
---

{
	sources.length > 0 && (
		<aside class="post-sources">
			<h2>Sources</h2>
			<ul>
				{sources.map((source) => (
					<li>
						<a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.post-sources {
		max-width: var(--measure);
		margin: 3rem auto 0;
		padding: 1.25rem 16px 0;
		border-top: 1px solid var(--line, #e8e2da);
		font-size: 0.85rem;
		color: var(--muted);
	}

	h2 {
		margin: 0 0 0.5rem;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	ul {
		margin: 0;
		padding-left: 1.1rem;
	}

	a {
		color: inherit;
	}
</style>
