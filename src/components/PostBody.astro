---
import type { Block } from '../lib/blocks';
import type { PhotoRow, VideoRow } from '../lib/db';
import type { MapStyle, MapView } from '../lib/map';
import { renderMarkdown } from '../lib/markdown';
import { playerUrl } from '../lib/stream';
import TripMap from './TripMap.astro';

interface Props {
	blocks: Block[];
	/** Every photo attached to the post. parseBody has already checked the blocks only reference these. */
	photos: PhotoRow[];
	/** Every video attached to the post (parseBody has checked the blocks only reference these). */
	videos?: VideoRow[];
	/** Where images are served from: the public route, or the admin route for previews of drafts. */
	mediaBase?: '/media/' | '/api/admin/media/';
	/** The map a map block shows, or null when the post's map is off or has no place to show. */
	map?: { view: MapView; style: MapStyle } | null;
}

const { blocks, photos, videos = [], mediaBase = '/media/', map = null } = Astro.props;
// The first block sits right under the title, so its photos load immediately.
const loadingFor = (index: number) => (index === 0 ? 'eager' : 'lazy');
const mediaUrl = (key: string) => `${mediaBase}${key}`;
const photosById = new Map(photos.map((photo) => [photo.id, photo]));
const photo = (id: string) => photosById.get(id)!;
const videosById = new Map(videos.map((video) => [video.id, video]));
const video = (id: string) => videosById.get(id)!;
---

<div class="post-body">
	{
		blocks.map((block, index) => {
			const loading = loadingFor(index);
			switch (block.type) {
				case 'heading':
					return <h2>{block.text}</h2>;
				case 'paragraph':
					return <div class="prose" set:html={renderMarkdown(block.markdown)} />;
				case 'quote':
					return (
						<blockquote>
							<p>{block.text}</p>
							{block.attribution && <cite>{block.attribution}</cite>}
						</blockquote>
					);
				case 'photo': {
					const p = photo(block.photoId);
					return (
						<figure class="wide">
							<a href={mediaUrl(p.r2_key_display)} data-lightbox-src={mediaUrl(p.r2_key_display)} data-lightbox-caption={p.caption}>
								<img src={mediaUrl(p.r2_key_display)} alt={p.alt} width={p.width} height={p.height} loading={loading} decoding="async" />
							</a>
							{p.caption && <figcaption>{p.caption}</figcaption>}
						</figure>
					);
				}
				case 'video': {
					const v = video(block.videoId);
					if (v.status !== 'ready' || !v.playback_host) {
						return <p class="video-pending">This video is still being processed and will appear here when it's ready.</p>;
					}
					// Width follows the video's shape, capped so tall phone videos fit on screen.
					const ratio = (v.width ?? 16) / (v.height ?? 9);
					return (
						<figure class="wide">
							<div class="video-frame" style={`--ratio: ${ratio}`}>
								<iframe
									src={playerUrl(v.playback_host, v.stream_uid)}
									title={v.caption || 'Video'}
									loading="lazy"
									allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
									allowfullscreen
								/>
							</div>
							{v.caption && <figcaption>{v.caption}</figcaption>}
						</figure>
					);
				}
				case 'map':
					return (
						map && (
							<div class="wide map-block">
								<TripMap view={map.view} style={map.style} />
							</div>
						)
					);
				case 'gallery':
					return (
						<div class={`gallery wide count-${block.photoIds.length}`}>
							{block.photoIds.map((id) => {
								const p = photo(id);
								return (
									<figure class="gallery-item">
										<a href={mediaUrl(p.r2_key_display)} data-lightbox-src={mediaUrl(p.r2_key_display)} data-lightbox-caption={p.caption}>
											<img src={mediaUrl(p.r2_key_thumb)} alt={p.alt} loading={loading} decoding="async" />
										</a>
										{p.caption && <figcaption>{p.caption}</figcaption>}
									</figure>
								);
							})}
						</div>
					);
			}
		})
	}
</div>

<style>
	.post-body {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 0 16px;
		font-size: 1.05rem;
	}

	.post-body > :global(*) {
		margin-block: 0 1.5rem;
	}

	h2 {
		font-size: 1.6rem;
		margin-top: 3rem !important;
	}

	.prose :global(p) {
		margin: 0 0 1.25rem;
	}

	.prose :global(a) {
		color: var(--accent);
	}

	blockquote {
		border-left: 3px solid var(--accent-soft);
		padding-left: 1.25rem;
		font-family: var(--serif);
		font-size: 1.3rem;
		font-style: italic;
	}

	blockquote p {
		margin: 0;
	}

	cite {
		display: block;
		margin-top: 0.5rem;
		font-family: var(--sans);
		font-size: 0.9rem;
		font-style: normal;
		color: var(--muted);
	}

	/* Photos and galleries run wider than the text column on large screens. */
	.wide {
		width: min(64rem, 100vw - 32px);
		margin-left: 50%;
		transform: translateX(-50%);
	}

	figure {
		margin-block: 2.5rem !important;
	}

	.map-block {
		margin-block: 2.5rem !important;
	}

	.map-block :global(.trip-map) {
		margin: 0;
	}

	/* Each photo keeps its own shape: full width when landscape, narrower and
	   centered when tall, with no frame around it. */
	figure img {
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: 85vh;
		margin: 0 auto;
	}

	figcaption {
		max-width: var(--measure);
		margin: 0.6rem auto 0;
		padding: 0 16px;
		font-size: 0.9rem;
		color: var(--muted);
		text-align: center;
	}

	.video-frame {
		width: min(100%, calc(85vh * var(--ratio)));
		aspect-ratio: var(--ratio);
		margin: 0 auto;
		background: #000;
	}

	.video-frame iframe {
		width: 100%;
		height: 100%;
		border: 0;
		display: block;
	}

	.video-pending {
		padding: 1.5rem;
		border: 1px dashed var(--rule);
		border-radius: 6px;
		text-align: center;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem 6px;
		align-items: start;
		margin-block: 2.5rem !important;
	}

	/* Each photo in a gallery is its own figure, so its caption sits under it. */
	.gallery .gallery-item {
		margin: 0 !important;
	}

	.gallery figcaption {
		margin-top: 0.4rem;
		padding: 0 4px;
		font-size: 0.85rem;
	}

	.gallery.count-2,
	.gallery.count-4 {
		grid-template-columns: repeat(2, 1fr);
	}

	.gallery img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		transition: opacity 0.2s;
	}

	.gallery a:hover img {
		opacity: 0.9;
	}

	@media (max-width: 600px) {
		.gallery {
			grid-template-columns: repeat(2, 1fr);
		}

		/* Odd counts in a two-column grid: the first photo spans the full width, so no row has a gap. */
		.gallery.count-3 .gallery-item:first-child,
		.gallery.count-5 .gallery-item:first-child {
			grid-column: span 2;
		}

		.gallery.count-3 .gallery-item:first-child img,
		.gallery.count-5 .gallery-item:first-child img {
			aspect-ratio: 2;
		}
	}
</style>
