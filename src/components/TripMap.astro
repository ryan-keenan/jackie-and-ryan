---
import type { MapStyle, MapView } from '../lib/map';

// Map with one labeled pin on the place a post is about. MapLibre and the map tiles load only
// when the map scrolls near view, so posts without a map, or readers who don't
// scroll to it, pay nothing. The drawing code is in src/scripts/trip-map.ts.
//
// With `preview`, the admin page can redraw the map by dispatching a
// "trip-map:update" event on the figure with { mode, style } as its detail, plus
// `view` when the pin has moved.

interface Props {
	view: MapView;
	style: MapStyle;
	preview?: boolean;
}

const { view, style, preview = false } = Astro.props;
---

<figure class="trip-map" data-style={style} data-preview={preview ? '' : undefined}>
	<div
		class="trip-map-canvas"
		data-map={JSON.stringify(view)}
		role="img"
		aria-label={view.label ? `Map showing ${view.label}` : 'Map of where the photos were taken'}
	>
	</div>
	<div class="trip-map-paper" aria-hidden="true">
		<svg class="trip-map-compass" viewBox="-50 -50 100 100">
			<g fill="none" stroke="#5a3d22" stroke-width="1.2"><circle r="30"></circle><circle r="26" stroke-width="0.6"></circle></g>
			<g fill="#5a3d22" stroke="#5a3d22" stroke-width="1">
				<polygon points="0,-46 6,0 0,6 -6,0"></polygon>
				<polygon points="0,46 6,0 0,-6 -6,0" fill="#e9dbbb"></polygon>
				<polygon points="46,0 0,5 -6,0 0,-5" fill="#e9dbbb"></polygon>
				<polygon points="-46,0 0,5 6,0 0,-5"></polygon>
			</g>
			<text y="-48" font-family="Fraunces, serif" font-size="11" text-anchor="middle" fill="#5a3d22">N</text>
		</svg>
	</div>
	{preview && <p class="trip-map-off">No map on this post</p>}
</figure>

<script>
	import type { MapMode, MapStyle, MapView } from '../lib/map';

	type Update = { mode: MapMode; style: MapStyle; view?: MapView };

	for (const figure of document.querySelectorAll<HTMLElement>('.trip-map')) {
		const container = figure.querySelector<HTMLElement>('.trip-map-canvas')!;
		const view = JSON.parse(container.dataset.map!) as MapView;
		let latest: Update = { mode: view.mode, style: figure.dataset.style as MapStyle };
		let drawn: Promise<import('../scripts/trip-map').TripMap> | null = null;

		const fail = (error: unknown) => {
			console.error('Map failed to load', error);
			container.textContent = `The map could not be loaded: ${(error as Error).message}`;
			container.classList.add('trip-map-error');
		};

		const draw = () => {
			// The admin preview may have changed the settings before the map was first drawn.
			const mode = latest.mode === 'off' ? view.mode : latest.mode;
			drawn ??= import('../scripts/trip-map').then(({ drawTripMap }) => drawTripMap(container, { ...(latest.view ?? view), mode }, latest.style));
			drawn.catch(fail);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					observer.disconnect();
					draw();
				}
			},
			{ rootMargin: '300px' },
		);
		observer.observe(container);

		if (figure.hasAttribute('data-preview')) {
			figure.addEventListener('trip-map:update', (event) => {
				latest = (event as CustomEvent<Update>).detail;
				figure.dataset.style = latest.style;
				figure.toggleAttribute('data-off', latest.mode === 'off');
				if (latest.mode === 'off' || !drawn) return;
				const { mode, style, view: moved } = latest;
				drawn.then((map) => map.update(mode, style, moved)).catch(fail);
			});
		}
	}
</script>

<style>
	.trip-map {
		position: relative;
		width: min(64rem, 100vw - 32px);
		margin: 0 auto 2.5rem;
	}

	.trip-map-canvas {
		height: clamp(240px, 40vw, 380px);
		border-radius: 6px;
		overflow: hidden;
		background: #f6f1ea;
	}

	:global(.trip-map-canvas .trip-map-pin) {
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--pin, #b8935f);
		border: 2px solid #fff;
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
	}

	/* The place name, beside the pin on a pill that reads on every map style.
	   Global, like the pin, so the post editor's map preview gets them too. */
	:global(.trip-map-canvas .trip-map-label) {
		position: absolute;
		left: calc(100% + 8px);
		top: 50%;
		transform: translateY(-50%);
		width: max-content;
		max-width: min(16rem, 40vw);
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.92);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
		font-family: var(--serif);
		font-size: clamp(0.95rem, 2.4vw, 1.15rem);
		line-height: 1.25;
		color: var(--text);
	}

	.trip-map[data-style='old-world'] .trip-map-canvas :global(.trip-map-label) {
		background: rgba(240, 228, 200, 0.92);
		color: #5a3d22;
		font-style: italic;
	}

	/* Old-world finish: paper grain, a vignette and a compass rose over the map. */
	.trip-map-paper {
		display: none;
		position: absolute;
		inset: 0;
		border-radius: 6px;
		pointer-events: none;
		mix-blend-mode: multiply;
		background:
			radial-gradient(ellipse at center, rgba(0, 0, 0, 0) 55%, rgba(92, 60, 25, 0.35) 100%),
			url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.45 0 0 0 0 0.33 0 0 0 0 0.18 0 0 0 0.18 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
	}

	.trip-map[data-style='old-world'] .trip-map-paper {
		display: block;
	}

	.trip-map-compass {
		position: absolute;
		left: 14px;
		bottom: 14px;
		width: 74px;
		height: 74px;
		opacity: 0.8;
	}

	.trip-map-off {
		display: none;
		position: absolute;
		inset: 0;
		margin: 0;
		place-items: center;
		background: rgba(255, 255, 255, 0.85);
		color: var(--muted);
		border-radius: 6px;
	}

	.trip-map[data-off] .trip-map-off {
		display: grid;
	}

	.trip-map-error {
		display: grid;
		place-items: center;
		color: var(--muted);
		font-size: 0.9rem;
	}
</style>
